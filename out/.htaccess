RewriteRule ^batteriespeicher-und-photovoltaik/?$ /batteriespeicher/ [R=301,L]
RewriteRule ^balkonkraftwerk-mit-speicher/?$ /balkonkraftwerke/ [R=301,L]
RewriteRule ^photovoltaik-beratung/?$ /kontakt/ [R=301,L]
RewriteRule ^energiemangementsystem/?$ /energiemanagementsystem/ [R=301,L]
RewriteRule ^referenzen-alt/?$ /referenzen/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-gewerbe-oberoesterreich/?$ /referenzen/projekt-gewerbe-oberoesterreich/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-pv-anlage-hotel-villach/?$ /referenzen/projekt-pv-anlage-hotel-villach/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-landwirtschaft-im-burgenland/?$ /referenzen/projekt-landwirtschaft-im-burgenland/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-stadthaus-in-graz/?$ /referenzen/projekt-stadthaus-in-graz/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-bitumendach-in-niederoesterreich/?$ /referenzen/projekt-bitumendach-in-niederoesterreich/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-pv-wien/?$ /referenzen/projekt-pv-wien/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-pv-am-ossiachersee/?$ /referenzen/projekt-pv-am-ossiachersee/ [R=301,L]
RewriteRule ^referenzen-alt/projekt-flachdach-in-graz/?$ /referenzen/projekt-flachdach-in-graz/ [R=301,L]
RewriteRule ^solar-in-kaernten/?$ / [R=301,L]
RewriteRule ^aktuelles/?$ /ratgeber/ [R=301,L]
RewriteRule ^category/uncategorized/?$ /ratgeber/ [R=301,L]
RewriteRule ^danke/?$ /kontakt/ [R=301,L]
RewriteRule ^marstek-lp/?$ /batteriespeicher/ [R=301,L]
RewriteRule ^pv-anlage-leasen/solar-basic/?$ /finanzierung/ [R=301,L]
RewriteRule ^pv-anlage-leasen/solar-comfort/?$ /finanzierung/ [R=301,L]
