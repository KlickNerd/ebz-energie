RewriteRule ^foerderung-photovoltaik-kaernten/?$ /photovoltaik-foerderung-kaernten/ [R=301,L]
RewriteRule ^photovoltaik-foerderung-oesterreich/?$ /photovoltaik-foerderung-oesterreich-2026/ [R=301,L]
RewriteRule ^pv-anlage-leasen/?$ /finanzierung/ [R=301,L]
RewriteRule ^marstek-venus/?$ /batteriespeicher/ [R=301,L]
RewriteRule ^entwicklung-oesterreichischer-strompreisindex-2023/?$ /marktpreis-2026/ [R=301,L]
RewriteRule ^zinsfreies-photovoltaik-und-speicherdarlehen-der-ak-kaernten/?$ /finanzierung/ [R=301,L]
RewriteRule ^akzeptanz-erneuerbare-energien/?$ /solarenergie/ [R=301,L]
RewriteRule ^professionelle-drohnenaufnahmen-von-ihrem-objekt/?$ /ueber-uns/ [R=301,L]
