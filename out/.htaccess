# Automatisch erzeugt von build/build_all.py aus build/redirects.txt. Nicht von Hand aendern.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# https und Hauptdomain ohne www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ebz-photovoltaik.at%{REQUEST_URI} [R=301,L]

# 301-Weiterleitungen alter WordPress-Adressen (75)
RewriteRule ^photovoltaik-landesfoerderungen-in-oesterreich/?$ /photovoltaik-landesfoerderungen/ [R=301,L]
RewriteRule ^kosten-von-photovoltaikanlagen-mit-speicher/?$ /kosten-einer-solaranlage/ [R=301,L]
RewriteRule ^einspeisetarif-photovoltaik-oesterreich-vergleich/?$ /einspeisetarif-fuer-photovoltaik/ [R=301,L]
RewriteRule ^einspeiseverguetung/?$ /einspeisetarif-fuer-photovoltaik/ [R=301,L]
RewriteRule ^pv-anlage-mit-notstrom-nachruesten/?$ /notstrom/ [R=301,L]
RewriteRule ^erneuerbare-energien/?$ /solarenergie/ [R=301,L]
RewriteRule ^photovoltaik-oesterreich/?$ /solarenergie/ [R=301,L]
RewriteRule ^photovoltaik-mieten/?$ /solaranlage-mieten-oder-kaufen/ [R=301,L]
RewriteRule ^solaranlage-mit-speicher-mieten/?$ /solaranlage-mieten-oder-kaufen/ [R=301,L]
RewriteRule ^oemag-einspeisetarif-energiegemeinschaft/?$ /oemag-einspeisetarif/ [R=301,L]
RewriteRule ^energiegemeinschaft-villach/?$ /energiegemeinschaft-villach-klagenfurt/ [R=301,L]
RewriteRule ^waermepumpen-installateur/?$ /waermepumpe/ [R=301,L]
