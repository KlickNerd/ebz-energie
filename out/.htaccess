RewriteRule ^waermepumpe-photovoltaik/?$ /photovoltaik-fuer-waermepumpe/ [R=301,L]
RewriteRule ^wallbox/?$ /wallbox-foerderung-kosten/ [R=301,L]
RewriteRule ^infrarotheizsysteme/?$ /infrarotheizung-mit-photovoltaik/ [R=301,L]
RewriteRule ^ersatzziegel/?$ /photovoltaik/ [R=301,L]
RewriteRule ^photovoltaik-wartung/?$ /photovoltaik/ [R=301,L]
RewriteRule ^waermepumpe-sea/?$ /waermepumpe/ [R=301,L]
RewriteRule ^waermepumpe-photovoltaik-lp/?$ /photovoltaik-fuer-waermepumpe/ [R=301,L]
RewriteRule ^foerderung-fuer-photovoltaik/?$ /foerderungen/ [R=301,L]
RewriteRule ^photovoltaik-foerderung/?$ /foerderungen/ [R=301,L]
RewriteRule ^photovoltaik-foerderung-in-kaernten-2026/?$ /photovoltaik-foerderung-kaernten/ [R=301,L]
RewriteRule ^stromspeicher/?$ /batteriespeicher/ [R=301,L]
RewriteRule ^kosten-einer-pv-anlage/?$ /kosten-einer-solaranlage/ [R=301,L]
RewriteRule ^luftwaermepumpe-kosten/?$ /kosten-einer-waermepumpe/ [R=301,L]
RewriteRule ^energiegemeinschaft-erfahrungen/?$ /energiegemeinschaft/ [R=301,L]
RewriteRule ^smart-meter-oesterreich/?$ /smart-meter/ [R=301,L]
RewriteRule ^balkonkraftwerk-in-kaernten/?$ /balkonkraftwerke/ [R=301,L]
RewriteRule ^photovoltaik-am-balkon/?$ /balkonkraftwerke/ [R=301,L]
RewriteRule ^photovoltaik-montage-firma/?$ /photovoltaik/ [R=301,L]
RewriteRule ^playground-startseite/?$ / [R=301,L]
RewriteRule ^author(/.*)?$ /ueber-uns/ [R=301,L]
RewriteRule ^category(/.*)?$ /ratgeber/ [R=301,L]
RewriteRule ^tag(/.*)?$ /ratgeber/ [R=301,L]
RewriteRule ^aktuelles(/.*)?$ /ratgeber/ [R=301,L]
RewriteRule ^page(/.*)?$ /ratgeber/ [R=301,L]
RewriteRule ^comments/feed(/.*)?$ /ratgeber/ [R=301,L]
RewriteRule ^feed(/.*)?$ /ratgeber/ [R=301,L]
RewriteRule ^sitemap_index\.xml/?$ /sitemap.xml [R=301,L]
RewriteRule ^page-sitemap\.xml/?$ /sitemap.xml [R=301,L]
RewriteRule ^post-sitemap\.xml/?$ /sitemap.xml [R=301,L]
RewriteRule ^category-sitemap\.xml/?$ /sitemap.xml [R=301,L]
RewriteRule ^author-sitemap\.xml/?$ /sitemap.xml [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
